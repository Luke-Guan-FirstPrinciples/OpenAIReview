# Set ONE or more API keys (first match is used for auto-detection):
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: override default model
# MODEL=anthropic/claude-opus-4-6

# Optional: set default provider for review (overrides auto-detection)
# REVIEW_PROVIDER=openrouter
# Choices: openrouter, openai, anthropic, gemini, mistral
# Can also be set via --provider CLI flag

# Optional: custom OpenAI base URL (e.g. EU endpoint, Azure)
# OPENAI_BASE_URL=https://eu.api.openai.com/v1

# Optional: related-work enrichment
# S2_API_KEY=your_semantic_scholar_api_key_here
# CONNECTED_PAPERS_API_KEY=your_connected_papers_api_key_here
# Alias also supported: ConnectedPapers_API_KEY
# SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.0

# Optional: LangSmith tracing for citation hallucination detection
# Install with: pip install 'openaireview[observability]'
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=openaireview

# Optional: Postgres connection for review feedback analytics
# Used by `openaireview serve` to record Helpful / Unhelpful / Rebuttal clicks
# Feedback is written to schema "playground_luke", table "review_feedback"
# Install driver with: pip install 'openaireview[feedback]'
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=your_db
# DB_USER=your_user
# DB_PASSWORD=your_password
